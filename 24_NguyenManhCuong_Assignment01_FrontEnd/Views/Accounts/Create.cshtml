@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.SystemAccountViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h4 class="fw-bold mb-1">Create New Account</h4>
                <p class="text-muted small mb-0">Add a new Staff or Lecturer account to the system</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="AccountName" class="form-control" placeholder="e.g. John Doe" />
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountEmail" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="AccountEmail" class="form-control" placeholder="name@domain.com" />
                        <span asp-validation-for="AccountEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountRole" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="AccountRole" class="form-select">
                            <option value="">-- Select Role --</option>
                            <option value="1">Staff (Manages news & categories)</option>
                            <option value="2">Lecturer (View-only)</option>
                        </select>
                        <span asp-validation-for="AccountRole" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AccountPassword" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="AccountPassword" type="password" class="form-control" placeholder="Enter account password" />
                        <span asp-validation-for="AccountPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
