@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.SystemAccountViewModel
@{
    ViewData["Title"] = "Delete Account";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-danger-subtle text-danger border-0 pt-4 px-4 pb-3 rounded-top-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Confirm Delete Account</h4>
                        <p class="small mb-0">Are you sure you want to delete this account?</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning small mb-4">
                    <i class="bi bi-info-circle me-1"></i>Note: Accounts that have created or updated news articles cannot be deleted.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-secondary">Account ID</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.AccountID</dd>

                    <dt class="col-sm-4 text-secondary">Full Name</dt>
                    <dd class="col-sm-8">@Model.AccountName</dd>

                    <dt class="col-sm-4 text-secondary">Email</dt>
                    <dd class="col-sm-8"><code>@Model.AccountEmail</code></dd>

                    <dt class="col-sm-4 text-secondary">Role</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.RoleDescription</span>
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AccountID" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Delete Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
