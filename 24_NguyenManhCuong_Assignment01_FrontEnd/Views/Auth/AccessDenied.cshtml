@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 border-0 shadow-sm rounded-4">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">You do not have permission to view this resource. Please log in with an authorized account.</p>
            <div>
                <a asp-controller="NewsArticles" asp-action="Index" class="btn btn-primary px-4 me-2">Go to News Portal</a>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary px-4">Switch Account</a>
            </div>
        </div>
    </div>
</div>
