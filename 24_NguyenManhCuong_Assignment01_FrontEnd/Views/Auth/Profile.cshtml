@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle me-3">
                        <i class="bi bi-person-gear fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Manage Profile</h4>
                        <p class="text-muted small mb-0">View and update your personal information</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AccountID" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="AccountName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="AccountName" class="form-control" />
                            <span asp-validation-for="AccountName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AccountEmail" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="AccountEmail" class="form-control" />
                            <span asp-validation-for="AccountEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Role</label>
                            <input value="@Model.RoleName" class="form-control bg-light" readonly />
                            <small class="text-muted">Account role is managed by Administrator.</small>
                        </div>

                        <div class="col-12"><hr class="my-2" /></div>

                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Leave empty to keep current" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 text-end">
                            <a asp-controller="NewsArticles" asp-action="Manage" class="btn btn-outline-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i>Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
