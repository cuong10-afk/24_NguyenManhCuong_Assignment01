@model IEnumerable<_24_NguyenManhCuong_Assignment01_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "My Article History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Article History</h2>
        <p class="text-muted small mb-0">Review all news articles published or drafted by you</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-pencil-square me-1"></i>New Article
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 100px;">ID</th>
                    <th scope="col">Headline</th>
                    <th scope="col">Category</th>
                    <th scope="col">Created Date</th>
                    <th scope="col">Modified Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary-subtle text-secondary">@item.NewsArticleID</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@item.NewsArticleID" class="text-dark text-decoration-none">
                                    @item.Headline
                                </a>
                            </td>
                            <td>
                                @if (item.Category != null)
                                {
                                    <span class="badge bg-light text-dark border">@item.Category.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="small text-muted">@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                            <td class="small text-muted">@(item.ModifiedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>
                                @if (item.NewsStatus == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Draft</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.NewsArticleID" class="btn btn-outline-secondary btn-sm me-1" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.NewsArticleID" class="btn btn-outline-primary btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.NewsArticleID" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-2 d-block mb-2"></i>
                            You have not created any articles yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
