@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.NewsArticleViewModel
@{
    ViewData["Title"] = "Delete Article";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-danger-subtle text-danger border-0 pt-4 px-4 pb-3 rounded-top-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Confirm Delete Article</h4>
                        <p class="small mb-0">Are you sure you want to permanently delete this news article?</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-secondary">Article ID</dt>
                    <dd class="col-sm-8 font-monospace fw-semibold">@Model.NewsArticleID</dd>

                    <dt class="col-sm-4 text-secondary">Headline</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Headline</dd>

                    <dt class="col-sm-4 text-secondary">Category</dt>
                    <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "-")</dd>

                    <dt class="col-sm-4 text-secondary">Author</dt>
                    <dd class="col-sm-8">@(Model.CreatedBy?.AccountName ?? "N/A")</dd>

                    <dt class="col-sm-4 text-secondary">Created Date</dt>
                    <dd class="col-sm-8 text-muted">@(Model.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="NewsArticleID" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Delete Article
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
