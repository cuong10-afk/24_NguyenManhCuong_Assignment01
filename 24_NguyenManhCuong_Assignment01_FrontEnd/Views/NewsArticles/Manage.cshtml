@model IEnumerable<_24_NguyenManhCuong_Assignment01_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "Manage News Articles";
    var categories = ViewBag.Categories as List<_24_NguyenManhCuong_Assignment01_FrontEnd.Models.CategoryViewModel> ?? new();
    short? currentCat = ViewBag.CurrentCategory as short?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">News Article Management</h2>
        <p class="text-muted small mb-0">Create, edit, review, and organize university news articles</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-pencil-square me-1"></i>Create New Article
    </a>
</div>

<!-- Search & Category Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Manage" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by title or headline..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">-- All Categories --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryID" selected="@(currentCat == c.CategoryID)">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Filter</button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || currentCat.HasValue)
                {
                    <a asp-action="Manage" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 100px;">ID</th>
                    <th scope="col">Headline / Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">Author</th>
                    <th scope="col">Created Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end" style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary-subtle text-secondary">@item.NewsArticleID</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.NewsArticleID" class="fw-semibold text-dark text-decoration-none">
                                    @item.Headline
                                </a>
                                @if (!string.IsNullOrEmpty(item.NewsTitle))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 320px;">@item.NewsTitle</div>
                                }
                            </td>
                            <td>
                                @if (item.Category != null)
                                {
                                    <span class="badge bg-light text-dark border">@item.Category.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="small">@(item.CreatedBy?.AccountName ?? "N/A")</td>
                            <td class="small text-muted">@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                            <td>
                                @if (item.NewsStatus == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Draft</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.NewsArticleID" class="btn btn-outline-secondary btn-sm me-1" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.NewsArticleID" class="btn btn-outline-primary btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.NewsArticleID" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No articles found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
