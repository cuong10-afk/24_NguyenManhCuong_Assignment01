@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.ReportViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">News Article Report & Statistics</h2>
    <p class="text-muted small mb-0">Generate period-based analytical reports for university news articles</p>
</div>

<!-- Date Range Filter Form -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <form asp-action="Generate" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="col-12 text-danger small"></div>

            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-calendar-check"></i></span>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-filter me-1"></i>Generate Report
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-primary-subtle text-primary rounded-4">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="p-3 bg-white rounded-circle me-3 shadow-sm">
                    <i class="bi bi-newspaper fs-3 text-primary"></i>
                </div>
                <div>
                    <h6 class="mb-1 text-primary-emphasis">Total Articles</h6>
                    <h2 class="fw-bold mb-0">@Model.TotalArticles</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success-subtle text-success rounded-4">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="p-3 bg-white rounded-circle me-3 shadow-sm">
                    <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                </div>
                <div>
                    <h6 class="mb-1 text-success-emphasis">Published Articles</h6>
                    <h2 class="fw-bold mb-0">@Model.ActiveArticles</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning-subtle text-warning-emphasis rounded-4">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="p-3 bg-white rounded-circle me-3 shadow-sm">
                    <i class="bi bi-file-earmark-text fs-3 text-warning"></i>
                </div>
                <div>
                    <h6 class="mb-1 text-warning-emphasis">Draft / Inactive</h6>
                    <h2 class="fw-bold mb-0">@Model.InactiveArticles</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Article List (Descending by Created Date)</h5>
            <small class="text-muted">From @Model.StartDate.ToString("MMM dd, yyyy") to @Model.EndDate.ToString("MMM dd, yyyy")</small>
        </div>
        <span class="badge bg-secondary">@Model.Articles.Count records</span>
    </div>
    <div class="card-body p-0 pt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 100px;">ID</th>
                        <th scope="col">Headline / Title</th>
                        <th scope="col">Category</th>
                        <th scope="col">Created Date</th>
                        <th scope="col">Author</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Articles.Any())
                    {
                        foreach (var item in Model.Articles)
                        {
                            <tr>
                                <td><span class="badge bg-secondary-subtle text-secondary">@item.NewsArticleID</span></td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Headline</div>
                                    @if (!string.IsNullOrEmpty(item.NewsTitle))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 320px;">@item.NewsTitle</div>
                                    }
                                </td>
                                <td>
                                    @if (item.Category != null)
                                    {
                                        <span class="badge bg-light text-dark border">@item.Category.CategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="small text-muted">@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                <td class="small">@(item.CreatedBy?.AccountName ?? "N/A")</td>
                                <td>
                                    @if (item.NewsStatus == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Draft</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                                No news articles created during this period.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
