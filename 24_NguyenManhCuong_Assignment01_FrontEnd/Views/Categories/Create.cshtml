@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.CategoryViewModel
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h4 class="fw-bold mb-1">Create New Category</h4>
                <p class="text-muted small mb-0">Define a new article classification</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g. Technology" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryDesciption" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="CategoryDesciption" class="form-control" rows="3" placeholder="Brief description of the category..."></textarea>
                        <span asp-validation-for="CategoryDesciption" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentCategoryID" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="ParentCategoryID" class="form-select" asp-items="ViewBag.ParentCategoryID">
                            <option value="">-- None (Root Category) --</option>
                        </select>
                        <span asp-validation-for="ParentCategoryID" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                        <label class="form-check-label fw-semibold small" for="isActiveSwitch">Category is Active</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Create Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
