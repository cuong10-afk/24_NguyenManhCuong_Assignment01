@model _24_NguyenManhCuong_Assignment01_FrontEnd.Models.CategoryViewModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-danger-subtle text-danger border-0 pt-4 px-4 pb-3 rounded-top-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Confirm Delete Category</h4>
                        <p class="small mb-0">Are you sure you want to delete this category?</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-warning small mb-4">
                    <i class="bi bi-info-circle me-1"></i>Note: A category can only be deleted if no news articles are currently assigned to it.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-secondary">Category ID</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.CategoryID</dd>

                    <dt class="col-sm-4 text-secondary">Category Name</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>

                    <dt class="col-sm-4 text-secondary">Description</dt>
                    <dd class="col-sm-8 text-muted">@Model.CategoryDesciption</dd>

                    <dt class="col-sm-4 text-secondary">Status</dt>
                    <dd class="col-sm-8">
                        @(Model.IsActive == true ? "Active" : "Inactive")
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryID" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Delete Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
