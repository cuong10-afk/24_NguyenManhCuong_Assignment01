@model IEnumerable<_24_NguyenManhCuong_Assignment01_FrontEnd.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Category Management</h2>
        <p class="text-muted small mb-0">Organize articles into hierarchical news categories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-folder-plus me-1"></i>Add New Category
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Category Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Parent Category</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary-subtle text-secondary">#@item.CategoryID</span></td>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td class="text-muted small">@item.CategoryDesciption</td>
                            <td>
                                @if (item.ParentCategory != null)
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-arrow-return-right me-1"></i>@item.ParentCategory.CategoryName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small"><em>None (Root)</em></span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.CategoryID" class="btn btn-outline-primary btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryID" class="btn btn-outline-danger btn-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                            No categories found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
